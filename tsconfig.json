{
  "extends": "./config/tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@/frontend/*": ["src/frontend/*"],
      "@/backend/*": ["src/backend/*"],
      "@/types": ["src/frontend/types"],
      "@/lib": ["src/backend/lib"],
      "@/lib/*": ["src/backend/lib/*"],
      "@/services": ["src/backend/services"],
      "@/services/*": ["src/backend/services/*"],
      "@/components/*": ["src/frontend/components/*"],
      "@/prisma": ["src/backend/prisma"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ]
}
